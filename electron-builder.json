{
  "appId": "com.zatygrafica.app",
  "productName": "Zaty Gráfica",
  "copyright": "Copyright © 2025 Zaty Gráfica, SU, LDA",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron-main/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron-main/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "signAndEditExecutable": false,
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Zaty Gráfica",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeader": "build/installer/header.bmp",
    "installerSidebar": "build/installer/welcome.bmp",
    "deleteAppDataOnUninstall": false,
    "menuCategory": true,
    "runAfterFinish": true,
    "license": "build/installer/LICENSE.txt",
    "include": "build/installer/installer.nsh",
    "perMachine": true,
    "allowElevation": true,
    "warningsAsErrors": false,
    "displayLanguageSelector": false,
    "installerLanguages": ["pt_BR"],
    "language": "2070",
    "multiLanguageInstaller": false,
    "guid": "a3f8c9d1-2b5e-4a7c-9f3e-1d8b4c6a2e5f"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "public/icon-512x512.png",
    "category": "public.app-category.business",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "public/icon-512x512.png",
    "category": "Office",
    "artifactName": "${productName}-${version}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "zatygrafica",
    "repo": "zaty-grafica-app",
    "releaseType": "release"
  }
}
