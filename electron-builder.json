{
  "appId": "com.zatygrafica.app",
  "productName": "Zaty Gráfica",
  "copyright": "Copyright © 2025 Zaty Gráfica, SU, LDA",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron-main/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron-main/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      }
    ],
    "icon": "public/logo.png",
    "publisherName": "Zaty Gráfica, SU, LDA",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Zaty Gráfica",
    "installerIcon": "public/logo.png",
    "uninstallerIcon": "public/logo.png",
    "installerHeader": "public/logo.png",
    "installerHeaderIcon": "public/logo.png",
    "deleteAppDataOnUninstall": false,
    "menuCategory": true,
    "runAfterFinish": true,
    "language": "2070"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "public/logo.png",
    "category": "public.app-category.business",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "public/logo.png",
    "category": "Office",
    "artifactName": "${productName}-${version}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "zatygrafica",
    "repo": "zaty-grafica-app",
    "releaseType": "release"
  }
}
